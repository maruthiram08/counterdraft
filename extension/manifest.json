{
    "manifest_version": 3,
    "name": "CounterDraft Lens",
    "version": "1.0.0",
    "description": "The Thinking Capture Layer for CounterDraft.",
    "permissions": [
        "activeTab",
        "scripting",
        "sidePanel",
        "storage",
        "tabs",
        "cookies"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "Snip"
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "side_panel": {
        "default_path": "src/sidepanel/index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/index.tsx"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}